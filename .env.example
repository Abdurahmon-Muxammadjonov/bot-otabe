# ============================================================
#  SOZLAMALAR  (bu faylni hech kimga bermang - tokenlar sir!)
# ============================================================

# 1) SO'ROV BOTI - mijozlar shu botga /start bosadi.
#    @otabeksobirov_bot
USER_BOT_TOKEN=

# 2) ADMIN BOTI - zayavkalar SHU botga tushadi (adminlar shu yerda ko'radi).
#    @BotFather -> /mybots -> botni tanlang -> API Token -> nusxa oling
#    va pastga qo'ying (bo'sh joysiz, bitta qatorga):
ADMIN_BOT_TOKEN=

# ------------------------------------------------------------
# Admin paroli: botga /start bosgan xodim shu parolni yozsa,
# unga zayavkalar kela boshlaydi. Uni albatta o'zgartiring!
ADMIN_PASSWORD=parolni_ozgartiring

# Doimiy adminlar (Telegram ID lar, vergul bilan). Ixtiyoriy.
# O'z ID ingizni bilish uchun botga /id yozing.
ADMIN_IDS=

# Kompaniya/xizmat nomi - salomlashuvda ko'rinadi.
COMPANY_NAME=Otabek Sobirov

# Mijozga ko'rsatiladigan aloqa ma'lumoti (ixtiyoriy).
CONTACT_INFO=

# Telegram ichida ochiladigan sotuv auditi mini app manzili.
# O'zingizning Netlify domeningiz bo'lsa, shu qiymatni almashtiring.
MINI_APP_URL=https://musical-sopapillas-ddba2b.netlify.app/

# ------------------------------------------------------------
# Qo'shimcha sozlamalar (odatda tegmasa ham bo'ladi)
SUBMIT_COOLDOWN_SEC=45
MAX_PER_DAY=5
TZ_OFFSET_HOURS=5
POLL_TIMEOUT=25
LOG_LEVEL=INFO

# ------------------------------------------------------------
# Ma'lumotlar papkasi. Lokalda tegmasa bo'ladi.
# Railway'da Volume ulasangiz: DATA_DIR=/data
DATA_DIR=
